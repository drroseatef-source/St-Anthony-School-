rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().role == 'admin';
    }
    function myCode() { return userDoc().studentId; }

    // حسابات المستخدمين (أدمن / مخدوم)
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // أول أدمن فقط: يتقفل تلقائيًا بعد إنشاء settings/adminlock
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'admin'
        && !exists(/databases/$(database)/documents/settings/adminlock);
      allow write: if isAdmin();
    }

    match /settings/adminlock {
      allow read: if true;
      allow create: if signedIn()
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && !exists(/databases/$(database)/documents/settings/adminlock);
    }
    match /settings/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /batches/{id}  { allow read: if signedIn(); allow write: if isAdmin(); }
    match /subjects/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /lectures/{id} { allow read: if signedIn(); allow write: if isAdmin(); }

    match /students/{code} {
      allow read: if isAdmin() || (signedIn() && userDoc().studentId == code);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (signedIn() && userDoc().studentId == code
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['init_pw'])
        && request.resource.data.init_pw == '');
    }

    match /materials/{id} { allow read: if signedIn(); allow write: if isAdmin(); }

    match /quizzes/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.status in ['open','closed']);
      allow write: if isAdmin();
    }

    match /quiz_results/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.student_id == myCode());
      allow create: if signedIn()
        && request.resource.data.student_id == myCode()
        && id == request.resource.data.quiz_id + '_' + myCode()
        && get(/databases/$(database)/documents/quizzes/$(request.resource.data.quiz_id)).data.status == 'open'
        && request.resource.data.total == get(/databases/$(database)/documents/quizzes/$(request.resource.data.quiz_id)).data.questions.size()
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= request.resource.data.total
        && request.resource.data.keys().hasOnly(['quiz_id','student_id','student_name','subject_id','year','week_no','score','total','ts']);
      allow update, delete: if isAdmin();
    }

    // الكروت والنقاط (XP): الأدمن بس يمنح / يصرف، والمخدوم يقرأ نقاطه هو بس
    match /xp_log/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.student_id == myCode());
      allow create, delete: if isAdmin();
      allow update: if false;
    }

    match /attendance/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.student_id == myCode());
      allow write: if isAdmin();
    }
  }
}
